# Build context of backend/Dockerfile (the project folder). Only what the API
# image needs is sent to Docker; above all, never .env files, keys or backups.
*
!alembic.ini
!alembic/
!backend/
!requirements.lock.txt
!requirements-test.lock.txt
!tests/
# The demo seed is tested in the test image only (never in the production image).
!scripts/

# Never in an image, even inside the folders above
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
backend/Dockerfile
# Checks the project's files (Dockerfiles, compose, .gitignore), which are not
# in the image; it runs on your PC and in CI instead.
tests/test_deployment_files.py
# Only the demo seed is needed from scripts/.
scripts/*
!scripts/seed_demo.py
