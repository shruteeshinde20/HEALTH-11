# Copy this file to .env and replace every placeholder.
# Never commit .env. Never put real values in this file.

# --- Application ---
# development, test or production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by docker-compose, Alembic and the API) ---
POSTGRES_DB=health11
POSTGRES_USER=health11
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Optional: a full SQLAlchemy URL. When set it overrides the POSTGRES_* values
# for the API and for Alembic.
# DATABASE_URL=postgresql+psycopg://health11:REPLACE_ME@127.0.0.1:5433/health11

# --- Authentication ---
# At least 32 random characters. Generate one in PowerShell with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Machine learning: folder for trained models (default: var/models) ---
# MODEL_DIR=C:\Users\you\HEALTH-11\var\models

# --- AI assistant (Anthropic API) ---
# Create a key at https://platform.claude.com/settings/keys (shown only once).
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
# Model ID, for example claude-sonnet-5-5 or claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# ASSISTANT_TIMEOUT_SECONDS=30
# ASSISTANT_MAX_REQUESTS_PER_USER=20
# ASSISTANT_WINDOW_SECONDS=600

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limits (optional; these are the defaults) ---
# RATE_LIMIT_WINDOW_SECONDS=900
# LOGIN_MAX_ATTEMPTS_PER_IP=30
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# REGISTER_MAX_ATTEMPTS_PER_IP=5
# REGISTER_WINDOW_SECONDS=3600

# --- Separate PostgreSQL database used only for tests (keep in .env.test) ---
# TEST_DATABASE_URL=postgresql+psycopg://health11:REPLACE_ME@127.0.0.1:5433/health11_test
