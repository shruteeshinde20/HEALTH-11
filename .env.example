# Copy this file to .env and replace every placeholder.
# Never commit .env. Never put real values in this file.

# --- Application ---
# development, test or production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by docker-compose, Alembic and the API) ---
POSTGRES_DB=health11
POSTGRES_USER=health11
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Optional: a full SQLAlchemy URL. When set it overrides the POSTGRES_* values
# for the API and for Alembic.
# DATABASE_URL=postgresql+psycopg://health11:REPLACE_ME@127.0.0.1:5433/health11

# --- Authentication ---
# At least 32 random characters. Generate one in PowerShell with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Seconds (10 to 600) a live-simulation stream token is valid; it travels in a WebSocket URL.
STREAM_TOKEN_EXPIRE_SECONDS=60

# --- Machine learning: folder for trained models (default: var/models) ---
# MODEL_DIR=C:\Users\you\HEALTH-11\var\models

# --- AI assistant: choose the service (anthropic, gemini, groq or ollama) ---
AI_PROVIDER=anthropic

# Anthropic: create a key at https://platform.claude.com/settings/keys (shown only once).
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
# Model ID, for example claude-sonnet-5-5 or claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# Gemini: create a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=replace_with_your_gemini_api_key
# GEMINI_MODEL=gemini-3.8-flash
# true while the key is on Google's free tier (Google may use what is sent to
# improve its products; use made-up data only). Not allowed in production.
# GEMINI_FREE_TIER=true
# GEMINI_API_VERSION=v1

# Groq: create a key at https://console.groq.com (API Keys). Production
# models listed at https://console.groq.com/docs/models, for example
# openai/gpt-oss-20b (fast) or openai/gpt-oss-120b (stronger).
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Ollama: a free model running on this computer (https://ollama.com); no key,
# no quota, nothing leaves the computer. Install Ollama, then for example:
#   ollama pull llama3.2
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://127.0.0.1:11434
# Local models are slower; seconds to wait for one answer (default 180).
# OLLAMA_TIMEOUT_SECONDS=180

# ASSISTANT_TIMEOUT_SECONDS=30
# ASSISTANT_MAX_REQUESTS_PER_USER=20
# ASSISTANT_WINDOW_SECONDS=600

# --- Reports ---
# Optional .ttf font for place names in other scripts (the built-in PDF font
# covers Western European letters only), for example C:\Windows\Fonts\arial.ttf
# REPORT_FONT_PATH=
# REPORT_MAX_REQUESTS_PER_USER=30
# REPORT_WINDOW_SECONDS=600

# --- Outside data: current weather from Open-Meteo (free, no key, for
# non-commercial use; commercial use needs their paid plan). Shown in the
# Scenario Builder as information only. WEATHER_ENABLED=false switches it off.
# WEATHER_ENABLED=true
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_CACHE_MINUTES=15
# WEATHER_REQUESTS_PER_DAY=2000

# --- E-mail for "Forgot password?" codes (leave SMTP_HOST empty to turn it off) ---
# Use a separate Gmail account made for the app, not a personal one. In that
# Google account turn on 2-step verification, then create an app password
# (Google Account > Security > App passwords) and put it in SMTP_PASSWORD.
# Gmail sends to up to 500 recipients a day for free.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# starttls or ssl (port 465); none is allowed only for a test server on this computer
# SMTP_SECURITY=starttls
# SMTP_USERNAME=your.app.account@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=your.app.account@gmail.com
# Optional: minutes a code is valid (5-60) and wrong tries allowed (1-10)
# PASSWORD_RESET_CODE_MINUTES=10
# PASSWORD_RESET_MAX_ATTEMPTS=5

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limits (optional; these are the defaults) ---
# RATE_LIMIT_WINDOW_SECONDS=900
# LOGIN_MAX_ATTEMPTS_PER_IP=30
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# REGISTER_MAX_ATTEMPTS_PER_IP=5
# REGISTER_WINDOW_SECONDS=3600

# --- Separate PostgreSQL database used only for tests (keep in .env.test) ---
# TEST_DATABASE_URL=postgresql+psycopg://health11:REPLACE_ME@127.0.0.1:5433/health11_test
