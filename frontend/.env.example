# HEALTH-11 website settings. Copy to .env.local and adjust.
# Values here are read by the website's server only; nothing is sent to browsers.

# Where the FastAPI backend runs (no trailing slash).
BACKEND_URL=http://127.0.0.1:8000

# Set to true only when an nginx (or similar) reverse proxy in front of the
# website sets X-Forwarded-For. Then each visitor's real IP is passed to the
# backend for its login rate limits. Leave false when visitors reach the
# website directly, because they could forge the header.
TRUST_PROXY_HEADERS=false
