# Settings for running HEALTH-11 with compose.production.yml.
# Copy this file to .env.production and replace every placeholder:
#   Copy-Item .env.production.example .env.production
#   notepad .env.production
# Never commit .env.production (git ignores it). Never put real values here.
# Docker refuses to start anything while POSTGRES_PASSWORD or JWT_SECRET_KEY
# is empty, so the database is never created with a missing password.

# --- Address of the site ---
# Your own PC: localhost and internal (Caddy makes its own certificate).
# A server: its domain name, and an e-mail address for Let's Encrypt.
SITE_HOST=localhost
CADDY_TLS=internal
# 127.0.0.1 = only this computer can open the site. A server: 0.0.0.0
PUBLISH_IP=127.0.0.1

# --- Database (its own, separate from the development database) ---
POSTGRES_DB=health11
POSTGRES_USER=health11
# A new random password, for example from:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Sign-in tokens ---
# At least 32 random characters, different from development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
STREAM_TOKEN_EXPIRE_SECONDS=60
LOG_LEVEL=INFO

# --- AI assistant (same choices as .env; see README "AI assistant") ---
# Use made-up data only with a cloud service. The free Gemini tier is refused
# in production. Ollama on the same PC is not reachable from inside Docker,
# so it cannot be used here.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
